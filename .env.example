# Copy to .env and fill in. Never commit .env.

# Required. The app refuses to start without this.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Required. Salt used to hash visitor IPs before storage. Generate as above.
IP_SALT=

NODE_ENV=development
PORT=3000

# Public base URL, used for sitemap and Open Graph tags.
SITE_URL=http://localhost:3000

# Optional. Without these, enquiries are still saved and visible in the
# admin dashboard — you simply get no email alert.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
