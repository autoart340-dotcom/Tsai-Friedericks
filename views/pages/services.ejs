<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="main">
  <section class="wrap page-head">
    <h1>Services</h1>
    <p class="lead">Full production, or the part of it you are missing.</p>
  </section>
  <section class="wrap section">
    <ul class="services plain">
      <% site.services.forEach(function (service) { %>
        <li class="service">
          <h2><%= service.title %></h2>
          <p><%= service.body %></p>
          <ul class="tags plain">
            <% service.includes.forEach(function (item) { %><li><%= item %></li><% }); %>
          </ul>
        </li>
      <% }); %>
    </ul>
  </section>
  <section class="cta">
    <div class="wrap">
      <h2>Not sure what you need?</h2>
      <p>Describe the project and we will tell you honestly what it takes.</p>
      <a class="btn btn-primary" href="/contact">Talk to us</a>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
