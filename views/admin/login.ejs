<%- include('_head') %>
<main class="admin-login">
  <form class="form card" method="post" action="/admin/login" novalidate>
    <h1>Sign in</h1>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="next" value="<%= next %>">
    <% if (formError) { %><p class="alert alert-error" role="alert"><%= formError %></p><% } %>
    <div class="field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required autocomplete="username" value="<%= values.email || '' %>">
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required autocomplete="current-password">
    </div>
    <button class="btn btn-primary" type="submit">Sign in</button>
  </form>
</main>
<%- include('_foot') %>
